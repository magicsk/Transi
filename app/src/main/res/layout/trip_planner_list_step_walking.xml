<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@+id/TripPlannerListStepWalkingIcon"
        android:layout_width="56dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_directions_walk"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TripPlannerListStepWalkingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/roboto"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/TripPlannerListStepWalkingPlatform"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepWalkingIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TripPlannerListStepWalkingPlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:drawablePadding="1dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_vertical"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        app:drawableStartCompat="@drawable/ic_platform"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBaseline_toBaselineOf="@id/TripPlannerListStepWalkingText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepWalkingText" />
</androidx.constraintlayout.widget.ConstraintLayout>
