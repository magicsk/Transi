<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/MHDTableRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/MHDTableSearchBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/MHDTable"
            android:layout_height="0dp"
            android:layout_width="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/MHDTableStopName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/locating_nearest_stop"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:textSize="26sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/MHDTableInfoButton"/>

            <com.google.android.material.button.MaterialButton
                style="?attr/materialIconButtonStyle"
                android:id="@+id/MHDTableInfoButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/table_service_info"
                app:icon="@drawable/ic_warning"
                app:layout_constraintEnd_toStartOf="@id/MHDTableMapButton"
                app:layout_constraintTop_toTopOf="@id/MHDTableStopName"
                app:layout_constraintBottom_toBottomOf="@id/MHDTableStopName"/>

            <com.google.android.material.button.MaterialButton
                style="?attr/materialIconButtonStyle"
                android:id="@+id/MHDTableMapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/table_show_on_map"
                app:icon="@drawable/ic_map"
                app:layout_constraintEnd_toStartOf="@id/MHDTableActualTime"
                app:layout_constraintTop_toTopOf="@id/MHDTableStopName"
                app:layout_constraintBottom_toBottomOf="@id/MHDTableStopName"/>

            <TextView
                android:id="@+id/MHDTableActualTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:minHeight="48dp"
                android:paddingHorizontal="8dp"
                android:gravity="center_vertical|end"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/roboto_medium"
                android:fontFeatureSettings="tnum"
                android:textSize="18sp"
                android:lines="1"
                app:layout_constraintTop_toTopOf="@id/MHDTableStopName"
                app:layout_constraintBottom_toBottomOf="@id/MHDTableStopName"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/MHDTableStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="25dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/MHDTableStopName">

                <TextView
                    android:id="@+id/MHDTableStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"/>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/table_status_track">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/MHDTableStatusConnecting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorColor="@color/table_status_indicator"
                        app:trackColor="@color/table_status_track"
                        app:trackCornerRadius="1dp"
                        app:trackThickness="2dp"/>

                    <View
                        android:id="@+id/MHDTableStatusDisconnected"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/table_status_error"
                        android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/MHDTableRefresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/MHDTableStatus">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/MHDTableList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/MHDTableLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/loading"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/MHDTableEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingHorizontal="25dp"
                android:text="@string/table_no_departures"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:visibility="gone"
                app:drawableTopCompat="@drawable/ic_no_departures"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:elevation="0dp"
            android:id="@+id/searchFragmentLayout"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/MHDTableSearchBar"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:layout_constraintTop_toBottomOf="@id/MHDTableRoot"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:background="@drawable/round_shape_50"
            android:hint="@string/search"
            android:id="@+id/editText"
            android:inputType="textNoSuggestions"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginVertical="10dp"
            android:lines="1"
            android:minHeight="48dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"
            android:singleLine="true"
            android:transitionName="original_editText"
            android:selectAllOnFocus="true"
            android:autofillHints="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/positionBtn"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.google.android.material.button.MaterialButton
            android:layout_height="56dp"
            android:layout_width="48dp"
            android:contentDescription="@string/enable_disable_switching_table_for_nearest_stop"
            android:id="@+id/positionBtn"
            android:layout_marginHorizontal="5dp"
            android:padding="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/editText"
            app:layout_constraintTop_toTopOf="parent"
            app:icon="@drawable/ic_location_search"
            app:iconGravity="textStart"
            app:strokeColor="@android:color/transparent"
            style="@style/Widget.Material3.Button.IconButton"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
