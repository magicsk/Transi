<?xml version="1.0" encoding="utf-8"?>
<!-- Only the weighted text area gives up height when the dialog would outgrow the screen, so long release notes
     scroll while the title and buttons stay visible; short notes still wrap to their content. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/AlertTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="15dp"
        android:paddingTop="15dp"
        android:fontFamily="@font/roboto_medium"
        android:text="@string/ops"
        android:textSize="24sp"/>

    <ScrollView
        android:id="@+id/AlertScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="15dp">

        <TextView
            android:id="@+id/AlertText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:text="@string/unknownError"/>
    </ScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/AlertProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:min="0"
        android:max="100"
        android:paddingVertical="10dp"
        android:visibility="gone"
        app:trackCornerRadius="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            style="@style/Widget.Material3.Button.TextButton"
            android:id="@+id/AlertCancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cancel"
            android:visibility="gone"
            android:layout_marginEnd="5dp"/>

        <Button
            style="@style/Widget.Material3.Button.TextButton"
            android:id="@+id/AlertConfirmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/ok"/>
    </LinearLayout>

</LinearLayout>
