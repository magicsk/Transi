<?xml version="1.0" encoding="utf-8"?>
<!-- TripDetailActivity: the journey on a full-screen map under the bars, with a persistent sheet over it. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tripDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TripDetailActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tripDetailMap"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown with the Thunderforest tiles, under the bar's end (anchored views ignore a top margin, hence the
         translation); the activity adds the side insets. Before the sheet, which covers it at full height. -->
    <TextView
        android:id="@+id/tripDetailAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/round_shape_50"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="@string/map_attribution"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:translationY="8dp"
        android:visibility="gone"
        app:layout_anchor="@id/tripDetailToolbar"
        app:layout_anchorGravity="bottom|end" />

    <!-- Summary, half and full heights; it never hides. The activity applies every inset itself. -->
    <LinearLayout
        android:id="@+id/tripDetailSheet"
        style="@style/Widget.Material3.BottomSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:behavior_fitToContents="false"
        app:behavior_halfExpandedRatio="0.5"
        app:behavior_hideable="false"
        app:gestureInsetBottomIgnored="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingLeftSystemWindowInsets="false"
        app:paddingRightSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/tripDetailDragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tripDetailList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tripDetailToolbar"
        style="@style/Widget.Transi.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/trip_detail_bar"
        android:elevation="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
