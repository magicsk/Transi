<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pickerToolbar"
        style="@style/Widget.Transi.TopAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/pref_default_stop" />

    <EditText
        android:id="@+id/pickerSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:autofillHints="none"
        android:background="@drawable/round_shape_50"
        android:backgroundTint="?attr/colorSurfaceContainerHigh"
        android:hint="@string/search"
        android:inputType="textNoSuggestions"
        android:minHeight="56dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:singleLine="true"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/pickerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:background="@drawable/stop_picker_card" />
</LinearLayout>
