<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/TripPlannerListStepLineNumLayout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:minWidth="56dp"
        app:layout_constraintBottom_toBottomOf="@id/TripPlannerListStepArrivalTime"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/TripPlannerListStepLineNum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_shape"
            android:fontFamily="@font/roboto_bold"
            android:padding="5dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/TripPlannerListStepLineArrow"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@drawable/rounded_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/TripPlannerListStepLineNum" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/TripPlannerListStepHeadsign"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:fontFamily="@font/roboto_bold"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingVertical="4dp"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepLineNumLayout"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TripPlannerListStepDepartureTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/roboto_medium"
        android:minEms="3"
        android:singleLine="true"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/TripPlannerListStepHeadsign"
        app:layout_constraintTop_toBottomOf="@id/TripPlannerListStepHeadsign" />

    <TextView
        android:id="@+id/TripPlannerListStepDepartureStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:fontFamily="@font/roboto_medium"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@id/TripPlannerListStepDepartureTime"
        app:layout_constraintEnd_toStartOf="@id/TripPlannerListStepDeparturePlatform"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepDepartureTime" />

    <TextView
        android:id="@+id/TripPlannerListStepDeparturePlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:drawablePadding="1dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_vertical"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        app:drawableStartCompat="@drawable/ic_platform"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBaseline_toBaselineOf="@id/TripPlannerListStepDepartureTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepDepartureStop" />

    <TextView
        android:id="@+id/TripPlannerListStepArrivalTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/roboto_medium"
        android:minEms="3"
        android:singleLine="true"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="@id/TripPlannerListStepHeadsign"
        app:layout_constraintTop_toBottomOf="@id/TripPlannerListStepDepartureTime" />

    <TextView
        android:id="@+id/TripPlannerListStepArrivalStop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:fontFamily="@font/roboto_medium"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:textSize="16sp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBaseline_toBaselineOf="@id/TripPlannerListStepArrivalTime"
        app:layout_constraintEnd_toStartOf="@id/TripPlannerListStepArrivalPlatform"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepArrivalTime" />

    <TextView
        android:id="@+id/TripPlannerListStepArrivalPlatform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:drawablePadding="1dp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_vertical"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        app:drawableStartCompat="@drawable/ic_platform"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:layout_constraintBaseline_toBaselineOf="@id/TripPlannerListStepArrivalTime"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/TripPlannerListStepArrivalStop" />
</androidx.constraintlayout.widget.ConstraintLayout>
