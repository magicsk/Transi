<?xml version="1.0" encoding="utf-8"?>
<!-- The M3 text button ripple, in the error colour. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.10" android:color="?attr/colorError" android:state_pressed="true" />
    <item android:alpha="0.10" android:color="?attr/colorError" android:state_focused="true" />
    <item android:alpha="0.08" android:color="?attr/colorError" android:state_hovered="true" />
    <item android:alpha="0.08" android:color="?attr/colorError" />
</selector>
