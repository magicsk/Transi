<?xml version="1.0" encoding="utf-8"?>
<!-- Keys and defaults match eu.magicsk.transi.util.Prefs; the threshold's title and steps are set by SettingsFragment. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_live_updates"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="live_activities_sounds"
            android:title="@string/pref_live_updates_sounds"
            app:iconSpaceReserved="false" />

        <eu.magicsk.transi.SliderPreference
            android:defaultValue="200"
            android:key="live_activity_threshold"
            android:max="600"
            app:iconSpaceReserved="false"
            app:min="30"
            app:seekBarIncrement="30"
            app:showSeekBarValue="false"
            app:updatesContinuously="true" />
    </PreferenceCategory>
</PreferenceScreen>
