<?xml version="1.0" encoding="utf-8"?>
<!-- Which changes of a followed departure alert; keys and defaults match eu.magicsk.transi.util.Prefs. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/pref_notification_triggers"
        app:iconSpaceReserved="false">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="notify_on_time_change"
            android:title="@string/pref_notify_time_change"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="notify_on_delay_change"
            android:title="@string/pref_notify_delay_change"
            app:iconSpaceReserved="false" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="notify_on_position_change"
            android:title="@string/pref_notify_position_change"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
