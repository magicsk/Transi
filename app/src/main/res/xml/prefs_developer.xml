<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/settings_developer">

        <EditTextPreference
            app:defaultValue=""
            app:iconSpaceReserved="false"
            app:key="magic_api_url_override"
            app:title="@string/settings_api_url" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="magic_api_url_reset"
            app:persistent="false"
            app:title="@string/settings_api_url_reset" />

        <Preference
            app:iconSpaceReserved="false"
            app:selectable="false"
            app:summary="@string/settings_api_url_footer" />

    </PreferenceCategory>

</PreferenceScreen>
