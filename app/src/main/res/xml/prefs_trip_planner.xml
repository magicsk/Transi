<?xml version="1.0" encoding="utf-8"?>
<!-- Keys and defaults match eu.magicsk.transi.util.Prefs; wired by SettingsFragment.bindTripPlanner. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:title="@string/trip_planner_settings"
        app:iconSpaceReserved="false">

        <SeekBarPreference
            app:key="trip_max_walk_duration"
            app:title="@string/trip_planner_max_walk_title"
            app:min="0"
            android:max="60"
            app:seekBarIncrement="1"
            app:showSeekBarValue="false"
            app:updatesContinuously="true"
            app:iconSpaceReserved="false"
            android:defaultValue="15" />

        <SeekBarPreference
            app:key="trip_max_transfers"
            app:title="@string/trip_planner_max_transfers_title"
            app:min="0"
            android:max="10"
            app:seekBarIncrement="1"
            app:showSeekBarValue="false"
            app:updatesContinuously="true"
            app:iconSpaceReserved="false"
            android:defaultValue="3" />

        <ListPreference
            app:key="trip_save_duration"
            app:title="@string/trip_planner_save_duration"
            app:entries="@array/trip_planner_save_duration_entries"
            app:entryValues="@array/trip_planner_save_duration_values"
            app:dialogTitle="@string/trip_planner_save_duration"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false"
            android:defaultValue="-1" />

        <!-- Turning it on also turns on offline timetables (SettingsFragment.bindTripPlanner). -->
        <SwitchPreferenceCompat
            app:key="offline_trip_planner"
            app:title="@string/offline_trip_planner"
            app:summary="@string/offline_trip_planner_summary"
            app:iconSpaceReserved="false"
            android:defaultValue="false" />
    </PreferenceCategory>
</PreferenceScreen>
