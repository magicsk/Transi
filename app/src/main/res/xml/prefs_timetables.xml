<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/timetables">

        <!-- Not persisted by the framework: TimetableDatabase owns the value in the "Transi" file. -->
        <SwitchPreferenceCompat
            app:iconSpaceReserved="false"
            app:key="offline_timetables"
            app:persistent="false"
            app:summary="@string/offline_timetables_summary"
            app:title="@string/offline_timetables" />

        <Preference
            app:iconSpaceReserved="false"
            app:key="timetable_delete_database"
            app:persistent="false"
            app:title="@string/timetable_delete_database" />

    </PreferenceCategory>
</PreferenceScreen>
