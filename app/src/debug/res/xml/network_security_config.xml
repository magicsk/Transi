<?xml version="1.0" encoding="utf-8"?>
<!-- Debug copy of main/res/xml/network_security_config.xml (it replaces it entirely): also allows cleartext to local dev servers. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- imhd.sk chains only to Sectigo Public Server Authentication Root R46, which Android ships from Android 15 on. -->
    <domain-config>
        <domain includeSubdomains="true">imhd.sk</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_public_server_authentication_root_r46" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
